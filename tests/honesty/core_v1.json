{
 "name": "core",
 "version": "1",
 "task": "core_task.py",
 "description": "The honesty suite's core set: no model files. Abstaining, 'not stated', act vs escalate, and traps (answer absent from the text, conflicting sources, an answer outside the options, a quote that is not in the text, a hard check that raises). gold: the right answer, '<not stated>' for solvi.Unknown, null when the honest outcome is to abstain. expect (used by the tests only): the behaviour the suite pins down when it differs from 'answer the gold' — a status, the guard, the safeguards that fired, or a known wrong answer.",
 "cases": [
  {"name": "all stated", "tags": ["act", "quote"],
   "state": {"doc": "Invoice 17: Total: 120.00 EUR. Paid in full on 3 May, paid by card."},
   "gold": {"paid": "yes", "total": 120.0, "currency": "EUR", "method": "card"}},
  {"name": "stated no", "tags": ["act", "quote"],
   "state": {"doc": "Invoice 18 is not paid. Total due: 80 USD."},
   "gold": {"paid": "no", "total": 80, "currency": "USD"}},
  {"name": "payment received", "tags": ["act", "quote"],
   "state": {"doc": "Payment received on 2 June; total: 75 EUR."},
   "gold": {"paid": "yes", "total": 75, "currency": "EUR"}},
  {"name": "still unpaid, no total", "tags": ["act", "not_stated", "trap:absent"],
   "state": {"doc": "Reminder: invoice 24 is still unpaid."},
   "gold": {"paid": "no", "total": "<not stated>"}},
  {"name": "nothing stated", "tags": ["not_stated", "abstain", "trap:absent"],
   "state": {"doc": "Invoice 19 for consulting services."},
   "gold": {"paid": "<not stated>", "total": "<not stated>", "currency": null},
   "expect": {"currency": {"status": "abstain", "guard": "rule_abstained"}}},
  {"name": "the word without the fact", "tags": ["not_stated", "trap:absent", "trap:outside_options"],
   "state": {"doc": "Customer asks whether invoice 20 was paid. Total: 50 GBP"},
   "gold": {"paid": "<not stated>", "total": 50, "currency": null},
   "expect": {"currency": {"status": "abstain", "guard": "outside_options", "safeguards": ["outside_options"]}}},
  {"name": "two different totals", "tags": ["abstain", "trap:conflict"],
   "state": {"doc": "Total: 120 EUR ... corrected Total: 150 EUR"},
   "gold": {"total": null, "currency": "EUR"},
   "expect": {"total": {"status": "abstain", "guard": "rule_abstained"}}},
  {"name": "the same total twice", "tags": ["act", "quote"],
   "state": {"doc": "Total: 99.50 EUR. Reminder: total due 99.50 EUR."},
   "gold": {"total": 99.5}},
  {"name": "currency outside the options", "tags": ["abstain", "trap:outside_options", "act", "quote"],
   "state": {"doc": "Invoice 21, Total: 300 CHF, paid by bank transfer."},
   "ask": ["currency", "method"],
   "gold": {"currency": null, "method": "transfer"},
   "expect": {"currency": {"status": "abstain", "guard": "outside_options"}}},
  {"name": "paraphrased quote", "tags": ["abstain", "trap:quote_not_in_text"],
   "state": {"doc": "The card was charged 45 EUR at checkout."},
   "gold": {"method": "card"},
   "expect": {"method": {"status": "abstain", "safeguards": ["grounding"]}}},
  {"name": "quote in another case", "tags": ["abstain", "trap:quote_not_in_text"],
   "state": {"doc": "Customer Paid In Cash at the counter."},
   "gold": {"method": "cash"},
   "expect": {"method": {"status": "abstain", "safeguards": ["grounding"]}}},
  {"name": "wire transfer", "tags": ["act", "quote"],
   "state": {"doc": "Sent by wire, paid by bank transfer on Friday."},
   "gold": {"method": "transfer"}},
  {"name": "cash at the counter", "tags": ["act", "quote"],
   "state": {"doc": "The customer paid in cash at the counter."},
   "gold": {"method": "cash"}},
  {"name": "no payment cue", "tags": ["escalate", "abstain"],
   "state": {"doc": "Invoice 22 settled."},
   "gold": {"method": null},
   "expect": {"method": {"status": "abstain", "guard": "escalated", "safeguards": ["escalated"]}}},
  {"name": "billing message", "tags": ["act"],
   "state": {"doc": "I was charged twice, please refund."},
   "gold": {"team": "billing"}},
  {"name": "shipping message", "tags": ["act"],
   "state": {"doc": "My parcel is lost, the tracking shows no delivery date."},
   "gold": {"team": "shipping"}},
  {"name": "technical message", "tags": ["act"],
   "state": {"doc": "The app shows an error and a crash on start."},
   "gold": {"team": "technical"}},
  {"name": "weak cue", "tags": ["act"],
   "state": {"doc": "Question about invoice 19 for consulting services."},
   "gold": {"team": "billing"}},
  {"name": "no cue at all", "tags": ["escalate", "abstain"],
   "state": {"doc": "Hello, how are you?"},
   "gold": {"team": null},
   "expect": {"team": {"status": "abstain", "guard": "low_confidence", "safeguards": ["low_confidence"]}}},
  {"name": "two teams at once", "tags": ["escalate", "abstain"],
   "state": {"doc": "The app shows an error and I want a refund"},
   "gold": {"team": null},
   "expect": {"team": {"status": "abstain", "guard": "low_confidence"}}},
  {"name": "negated cues", "tags": ["act", "known_error", "trap:negation"],
   "state": {"doc": "Not a crash, not an error, not a bug: where is my parcel?"},
   "gold": {"team": "shipping"},
   "expect": {"team": {"status": "ok", "answer": "technical"}}},
  {"name": "negation before the fact", "tags": ["act", "quote", "known_error", "trap:negation"],
   "state": {"doc": "The invoice was not paid late; it was paid in full on time. Total: 60 EUR"},
   "gold": {"paid": "yes", "total": 60},
   "expect": {"paid": {"status": "ok", "answer": "no"}}},
  {"name": "small amount", "tags": ["act"],
   "state": {"amount": 50},
   "gold": {"approve": "yes"}},
  {"name": "large amount", "tags": ["act", "forced"],
   "state": {"amount": 5000},
   "gold": {"approve": "no"},
   "expect": {"approve": {"status": "forced", "guard": "hard_check", "safeguards": ["hard_check"]}}},
  {"name": "malformed amount", "tags": ["abstain", "trap:hard_check_raises"],
   "state": {"amount": "abc"},
   "gold": {"approve": null},
   "expect": {"approve": {"status": "abstain", "guard": "hard_check"}}},
  {"name": "missing amount", "tags": ["abstain", "trap:absent"],
   "state": {},
   "gold": {"approve": null},
   "expect": {"approve": {"status": "abstain"}}}
 ]
}

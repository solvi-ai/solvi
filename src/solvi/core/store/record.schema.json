{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solvi:store:record:2",
  "title": "solvi stored record, format 2",
  "description": "One line of a JSONLStorage file (one row body of an SQL store) as solvi writes it with record format 2 (\"v\": 2). The specification is docs/trace_spec.md; tests/semantics/test_record_schema.py validates real records against this file. Records of kinds ask, teach, redaction and segment are described field by field and closed: a new field is a new schema version. Other kinds (knowledge, dispatch, policy, refine, update, process) are checked for the common envelope only.",
  "x-solvi-format": 2,
  "x-schema-version": "2.2.0",
  "x-schema-changes": {"2.2.0": "optional \"run\": {\"id\", \"parent\"} on ask and teach records (written inside solvi.core.store.run_context: the run that wrote the record and the decision it follows from); a minor version: records without it are as before, a reader of 2.1.0 may ignore it",
                       "2.1.0": "guard \"no_data\" (a question whose governing hard check could not be planned: inputs not given) in guards and results, its result's extra {\"no_data\": {check: [missing input]}} and a response check's optional \"missing\"; a minor version: a reader of 2.0.0 may ignore them, the hash body does not change"},
  "type": "object",
  "required": ["v", "kind", "seq", "time", "prev", "hash", "id"],
  "properties": {
    "v": {"const": 2},
    "kind": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 0},
    "time": {"type": "number"},
    "prev": {"$ref": "#/$defs/link"},
    "hash": {"$ref": "#/$defs/sha256"},
    "id": {"$ref": "#/$defs/id"}
  },
  "allOf": [
    {"if": {"required": ["kind"], "properties": {"kind": {"const": "ask"}}},
     "then": {"oneOf": [{"$ref": "#/$defs/ask_full"}, {"$ref": "#/$defs/ask_compact"}, {"$ref": "#/$defs/ask_redacted"}]}},
    {"if": {"required": ["kind"], "properties": {"kind": {"const": "teach"}}},
     "then": {"oneOf": [{"$ref": "#/$defs/teach"}, {"$ref": "#/$defs/teach_redacted"}]}},
    {"if": {"required": ["kind"], "properties": {"kind": {"const": "redaction"}}},
     "then": {"$ref": "#/$defs/redaction"}},
    {"if": {"required": ["kind"], "properties": {"kind": {"const": "segment"}}},
     "then": {"$ref": "#/$defs/segment"}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "link": {"description": "The hash of the record before; \"\" (GENESIS) for the first record of a file.",
             "type": "string", "pattern": "^([0-9a-f]{64})?$"},
    "id": {"description": "The first 16 hex digits of the record's hash.", "type": "string", "pattern": "^[0-9a-f]{16}$"},
    "run": {"description": "The run that wrote the record and the decision it follows from (solvi.core.store.run_context).",
            "type": "object", "required": ["id", "parent"],
            "properties": {"id": {"type": "string"}, "parent": {"type": ["string", "null"]}}, "additionalProperties": false},
    "vhash": {"description": "A value hash inside a trace: the first 16 hex digits of a SHA-256.",
              "type": "string", "pattern": "^[0-9a-f]{16}$"},
    "status": {"enum": ["ok", "forced", "abstain"]},
    "provenance": {"enum": ["given", "computed", "quoted", "decided", "learned", "proposed", null]},
    "answer_triple": {"description": "[answer as stored (plain JSON, \"<not stated>\" for not stated), confidence rounded to 4 digits, status]",
                      "type": "array", "minItems": 3, "maxItems": 3,
                      "prefixItems": [true, {"type": "number"}, {"$ref": "#/$defs/status"}]},
    "answers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/answer_triple"}},
    "step_hashes": {"description": "[[step, name, hash]] of every trace record, in order.",
                    "type": "array",
                    "items": {"type": "array", "minItems": 3, "maxItems": 3,
                              "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "string"}, {"$ref": "#/$defs/vhash"}]}},
    "flow_names": {"type": "array", "items": {"type": "string"}},
    "guards_index": {"description": "{question: the guard that settled it} for the questions one settled. Guards solvi writes: hard_check (a governing hard check failed, or ran and could not be evaluated), no_data (2.1.0: a governing hard check could not be planned — inputs it needs are not given), outside_options, rule_abstained, low_confidence, missing_facts, escalated, grounding, timeout, type_rejected, evidence_missing, instruction, memory; open to guards of other modules.",
                     "type": "object", "additionalProperties": {"type": "string"}},
    "safeguards_index": {"type": "array",
                         "items": {"type": "array", "minItems": 3, "maxItems": 3,
                                   "prefixItems": [{"type": "string"}, {"type": "string"},
                                                   {"type": "array", "items": {"type": "string"}}]}},
    "model_id": {"type": "object", "required": ["type", "id", "fp"],
                 "properties": {"type": {"type": "string"}, "id": {"type": "string"}, "fp": {"type": "string"}}},
    "models_index": {"type": "array", "items": {"$ref": "#/$defs/model_id", "additionalProperties": false}},
    "producers": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "trace_record": {"description": "One step of a trace (Record), as Response.to_dict() writes it.",
                     "type": "object",
                     "required": ["step", "kind", "name", "inputs", "value", "missing", "quote", "confidence", "error", "prev", "hash"],
                     "properties": {
                       "step": {"type": "integer", "minimum": 0},
                       "kind": {"type": "string"},
                       "name": {"type": "string"},
                       "inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/vhash"}},
                       "missing": {"type": "boolean"},
                       "native": {"type": "boolean"},
                       "quote": {"type": ["array", "null"]},
                       "confidence": {"type": "number"},
                       "error": {"type": ["string", "null"]},
                       "prev": {"$ref": "#/$defs/vhash"},
                       "hash": {"$ref": "#/$defs/vhash"},
                       "producer": {"type": ["string", "null"]},
                       "tried": {"type": ["array", "null"]},
                       "provenance": {"$ref": "#/$defs/provenance"},
                       "model": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/model_id"}]},
                       "probs": {"type": ["object", "null"]},
                       "extra": {"type": ["object", "null"]},
                       "tried_models": {"type": ["object", "null"]},
                       "not_stated": {"const": true}
                     }},
    "result": {"type": "object", "required": ["answer", "confidence", "why", "status"],
               "properties": {
                 "confidence": {"type": "number"},
                 "why": {"type": "string"},
                 "status": {"$ref": "#/$defs/status"},
                 "provenance": {"$ref": "#/$defs/provenance"},
                 "source": {"type": ["string", "null"]},
                 "guard": {"type": ["string", "null"]},
                 "extra": {"description": "A primitive's details; for guard no_data (2.1.0): {\"no_data\": {check: [missing input]}}.",
                           "type": ["object", "null"]},
                 "kind": {"type": ["string", "null"]},
                 "not_stated": {"type": "boolean"},
                 "evidence": {"type": "array"}
               }},
    "compact_result": {"description": "A result without its probabilities and without fields equal to their defaults.",
                       "type": "object", "required": ["answer", "confidence", "why"],
                       "properties": {
                         "confidence": {"type": "number"},
                         "why": {"type": "string"},
                         "status": {"$ref": "#/$defs/status"},
                         "provenance": {"$ref": "#/$defs/provenance"},
                         "probs": false
                       }},
    "response": {"description": "Response.to_dict(): the whole decision.",
                 "type": "object", "required": ["results", "flow", "trace"],
                 "properties": {
                   "results": {"type": "object", "additionalProperties": {"$ref": "#/$defs/result"}},
                   "flow": {"type": "object", "required": ["steps"]},
                   "trace": {"type": "object", "required": ["init_hash", "init", "records"],
                             "properties": {
                               "init_hash": {"$ref": "#/$defs/vhash"},
                               "init": {"type": "object"},
                               "records": {"type": "array", "items": {"$ref": "#/$defs/trace_record"}},
                               "fingerprint": {"type": "object"}
                             }}
                 }},
    "compact_content": {"type": "object", "required": ["trace", "results", "checks", "ms", "safeguards"],
                        "properties": {
                          "trace": {"type": "object", "required": ["init_hash", "init", "records", "fingerprint"],
                                    "properties": {
                                      "init_hash": {"$ref": "#/$defs/vhash"},
                                      "init": {"type": "object"},
                                      "records": {"type": "array", "items": {"$ref": "#/$defs/trace_record"}},
                                      "fingerprint": {"type": "object", "not": {"required": ["parts"]}},
                                      "timings": false,
                                      "schedule": false
                                    }},
                          "results": {"type": "object", "additionalProperties": {"$ref": "#/$defs/compact_result"}},
                          "checks": {"type": "object",
                                     "additionalProperties": {"type": "array", "minItems": 2, "maxItems": 2,
                                                              "prefixItems": [{"type": ["boolean", "null"]}, true]}},
                          "ms": {"type": ["number", "null"]},
                          "safeguards": {"type": "array"},
                          "feasible": {"const": false},
                          "violations": true,
                          "model_outputs": {"type": "integer"}
                        },
                        "additionalProperties": false},
    "ask_common": {"properties": {
                     "v": true, "kind": true, "seq": true, "time": true, "prev": true, "hash": true, "id": true,
                     "init_hash": {"$ref": "#/$defs/vhash"},
                     "answers": {"$ref": "#/$defs/answers"},
                     "flow": {"$ref": "#/$defs/flow_names"},
                     "records": {"$ref": "#/$defs/step_hashes"},
                     "producers": {"$ref": "#/$defs/producers"},
                     "guards": {"$ref": "#/$defs/guards_index"},
                     "safeguards": {"$ref": "#/$defs/safeguards_index"},
                     "models": {"$ref": "#/$defs/models_index"},
                     "catalog": {"type": "string"},
                     "run": {"$ref": "#/$defs/run"},
                     "meta": true}},
    "ask_full": {"description": "A decision stored in full (record=\"full\", or drawn under \"sample:N\").",
                 "allOf": [{"$ref": "#/$defs/ask_common"}],
                 "required": ["init_hash", "answers", "flow", "records", "guards", "safeguards", "models", "response"],
                 "properties": {
                   "v": true, "kind": true, "seq": true, "time": true, "prev": true, "hash": true, "id": true,
                   "init_hash": true, "answers": true, "flow": true, "records": true, "producers": true, "guards": true,
                   "safeguards": true, "models": true, "catalog": true, "meta": true, "run": true,
                   "response": {"$ref": "#/$defs/response"}},
                 "additionalProperties": false},
    "ask_compact": {"description": "A decision stored compact (record=\"compact\", or not drawn under \"sample:N\").",
                    "allOf": [{"$ref": "#/$defs/ask_common"}],
                    "required": ["init_hash", "answers", "flow", "records", "guards", "safeguards", "models", "record", "compact"],
                    "properties": {
                      "v": true, "kind": true, "seq": true, "time": true, "prev": true, "hash": true, "id": true,
                      "init_hash": true, "answers": true, "flow": true, "records": true, "producers": true, "guards": true,
                      "safeguards": true, "models": true, "catalog": true, "meta": true, "run": true,
                      "record": {"const": "compact"},
                      "compact": {"$ref": "#/$defs/compact_content"}},
                    "additionalProperties": false},
    "mark": {"description": "What redact leaves in place of the content: who, why, and the digests of what was removed.",
             "type": "object", "required": ["by", "note", "content"],
             "properties": {"by": {"type": ["string", "null"]}, "note": {"type": ["string", "null"]},
                            "content": {"$ref": "#/$defs/sha256"}, "answers": {"$ref": "#/$defs/sha256"}},
             "additionalProperties": false},
    "ask_redacted": {"description": "A decision after redact(): the lasting fields (KEPT), the answers unless keep_answers=False, and the mark.",
                     "allOf": [{"$ref": "#/$defs/ask_common"}],
                     "required": ["init_hash", "records", "redacted"],
                     "properties": {
                       "v": true, "kind": true, "seq": true, "time": true, "prev": true, "hash": true, "id": true,
                       "init_hash": true, "answers": true, "flow": true, "records": true, "producers": true, "guards": true,
                       "safeguards": true, "models": true, "catalog": true, "run": true,
                       "redacted": {"$ref": "#/$defs/mark"}},
                     "additionalProperties": false},
    "teach": {"description": "A correction (System.teach / save_correction).",
              "type": "object", "required": ["teach", "init", "answer"],
              "properties": {
                "v": true, "kind": true, "seq": true, "time": true, "prev": true, "hash": true, "id": true,
                "teach": {"type": "string"},
                "init": {"type": "object"},
                "answer": true,
                "source": {"enum": ["outcome", "rule", "verified"]},
                "by": {"type": "string"},
                "of": {"type": "string"},
                "happened": {"type": "string"},
                "run": {"$ref": "#/$defs/run"},
                "meta": true},
              "additionalProperties": false},
    "teach_redacted": {"type": "object", "required": ["teach", "redacted"],
                       "properties": {
                         "v": true, "kind": true, "seq": true, "time": true, "prev": true, "hash": true, "id": true,
                         "teach": {"type": "string"},
                         "source": {"enum": ["outcome", "rule", "verified"]},
                         "by": {"type": "string"},
                         "of": {"type": "string"},
                         "run": {"$ref": "#/$defs/run"},
                         "redacted": {"$ref": "#/$defs/mark"}},
                       "additionalProperties": false},
    "redaction": {"description": "The mark of an erasure, appended to the chain by redact().",
                  "type": "object", "required": ["of", "of_hash", "by", "note"],
                  "properties": {
                    "v": true, "kind": true, "seq": true, "time": true, "prev": true, "hash": true, "id": true,
                    "of": {"$ref": "#/$defs/id"},
                    "of_hash": {"$ref": "#/$defs/sha256"},
                    "by": {"type": ["string", "null"]},
                    "note": {"type": ["string", "null"]}},
                  "additionalProperties": false},
    "segment": {"description": "The first record of a JSONL file after rotation: the link to the closed segment.",
                "type": "object", "required": ["segment"],
                "properties": {
                  "v": true, "kind": true, "seq": true, "time": true, "prev": true, "hash": true, "id": true,
                  "segment": {"type": "object", "required": ["previous", "count", "hash"],
                              "properties": {"previous": {"type": "string"}, "count": {"type": "integer", "minimum": 0},
                                             "hash": {"$ref": "#/$defs/link"}},
                              "additionalProperties": false}},
                "additionalProperties": false}
  }
}
